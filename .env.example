# Where the database lives. sqlite:<path> or postgres://user:pass@host/db
DATABASE_URL=sqlite:clubbie.db

# Only for running the store suite against a real Postgres. It is a separate variable because the
# fixture empties every table in whatever it opens: never point it at the database above.
TEST_DATABASE_URL=

# Public origin the app is reached at. OAuth redirects, calendar urls and every link the club
# sends are built from it.
BASE_URL=http://localhost:3000

# openssl rand -base64 32. It signs the cookie that carries an in-flight sign-in and every
# member's calendar url, so rotating it retires every calendar subscription. It does not sign the
# session cookie, which is an opaque token, and rotating it signs nobody out.
SESSION_SECRET=

# At least one OAuth provider. Others are inert while unset.
EDUID_CLIENT_ID=
EDUID_CLIENT_SECRET=
# Only for a different eduID deployment. Defaults to https://login.eduid.ch
EDUID_ISSUER=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: the Telegram bot that links accounts and carries announcements.
TELEGRAM_TOKEN=

# Optional: email, for members who never link a chat. Both or neither.
EMAIL_API_KEY=
EMAIL_FROM=
# Any API that takes the same JSON. Defaults to Resend's.
EMAIL_ENDPOINT=

# Set only when something in front of this process rewrites x-forwarded-for. The throttle
# believes those headers when it is set, and a caller writes them itself when it is not.
TRUST_PROXY=

# The wall clock a repeating event keeps when the club has not set a timezone in its settings.
# Leave it out to use the host's zone: an empty TZ is UTC, not "unset". It is read by the runtime
# rather than by the config, so a bad value is not refused at boot.
# TZ=Europe/Zurich

PORT=3000

# trace, debug, info, warn, error
LOG_LEVEL=info
# Set to write one JSON object per line, for a log collector.
LOG_JSON=
# The built SPA this process serves in front of the API.
ASSETS=packages/web/dist
