# Where the database lives. sqlite:<path> or postgres://user:pass@host/db
DATABASE_URL=sqlite:clubbie.db

# Only for running the store suite against a real Postgres. It is a separate variable because the
# fixture empties every table in whatever it opens: never point it at the database above.
TEST_DATABASE_URL=

# Public origin the app is reached at. OAuth redirects, calendar urls and every link the club
# sends are built from it.
BASE_URL=http://localhost:3000

# openssl rand -base64 32. It signs the cookie that carries an in-flight sign-in and every
# member's calendar url, so rotating it retires every calendar subscription. It does not sign the
# session cookie, which is an opaque token, and rotating it signs nobody out.
SESSION_SECRET=

# At least one sign-in provider. Others are inert while unset, and each one is an id and a secret.
EDUID_CLIENT_ID=
EDUID_CLIENT_SECRET=
# Only for a different eduID deployment. Defaults to https://login.eduid.ch
EDUID_ISSUER=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# One tenant instead of every Entra and personal account:
# https://login.microsoftonline.com/<tenant>/v2.0
MICROSOFT_ISSUER=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# A self-hosted GitLab. Defaults to https://gitlab.com
GITLAB_ISSUER=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Any other OpenID Connect provider: Keycloak, Authentik, Zitadel, a campus IdP. The issuer is
# required, because it is the only thing that says which provider this is.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=

# Instead of a client secret, any OpenID Connect provider above takes a private key (RFC 7523
# private_key_jwt): a pkcs#8 pem, with \n written literally if the value has to be one line.
# OIDC_PRIVATE_KEY=
# The kid the public half was registered under, and what it is signed with. Defaults to RS256.
# OIDC_KEY_ID=
# OIDC_KEY_ALGORITHM=

# Optional: the Telegram bot that links accounts and carries announcements.
TELEGRAM_TOKEN=

# Optional: email, for members who never link a chat. The sender is always needed; the rest
# depends on the transport, and a missing one is named at boot.
EMAIL_FROM=
# resend (default), postmark, sendgrid, mailgun, brevo, mailjet, smtp
EMAIL_TRANSPORT=resend
EMAIL_API_KEY=
# Mailjet only, which authenticates with a pair.
EMAIL_API_SECRET=
# Mailgun only: the domain it sends for, which is part of its url.
EMAIL_DOMAIN=
# smtp only: smtp://user:pass@host:587 or smtps://user:pass@host:465
EMAIL_SMTP_URL=
# Overrides where a provider's api lives: another region, a relay, a test double.
EMAIL_ENDPOINT=

# Set only when something in front of this process rewrites x-forwarded-for. The throttle
# believes those headers when it is set, and a caller writes them itself when it is not.
TRUST_PROXY=

# The wall clock a repeating event keeps when the club has not set a timezone in its settings.
# Leave it out to use the host's zone: an empty TZ is UTC, not "unset". It is read by the runtime
# rather than by the config, so a bad value is not refused at boot.
# TZ=Europe/Zurich

PORT=3000

# trace, debug, info, warn, error
LOG_LEVEL=info
# Set to write one JSON object per line, for a log collector.
LOG_JSON=
# The built SPA this process serves in front of the API.
ASSETS=packages/web/dist
