# What the container reads. Compose picks this file up as `docker/.env`; the repository's own
# `.env` is for a dev server and is deliberately not shared with it.

# The port on the host. The container always listens on 3000.
HTTP_PORT=3000

# The public origin members reach. OAuth redirects, calendar urls and every link the club sends
# are built from it, so it is the address behind your proxy, not localhost, in production.
BASE_URL=http://localhost:3000

# openssl rand -base64 32
SESSION_SECRET=

# The volume the image declares. Change it only to run Postgres instead:
# DATABASE_URL=postgres://clubbie:clubbie@postgres:5432/clubbie
DATABASE_URL=sqlite:/data/clubbie.db

# At least one OAuth provider. Others are inert while unset.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
EDUID_CLIENT_ID=
EDUID_CLIENT_SECRET=

# Optional: the Telegram bot that links accounts and carries announcements.
TELEGRAM_TOKEN=

# Optional: email, for members who never link a chat. Both or neither.
EMAIL_API_KEY=
EMAIL_FROM=

# Set when a proxy in front of this container rewrites x-forwarded-for.
TRUST_PROXY=

# The wall clock a repeating event keeps when the club has set no timezone. A container carries
# no zone at all, so an unset TZ here is UTC.
TZ=Europe/Zurich

LOG_LEVEL=info
# Set to write one JSON object per line, for a log collector.
LOG_JSON=

# Only when the postgres profile is running.
POSTGRES_USER=clubbie
POSTGRES_PASSWORD=clubbie
POSTGRES_DB=clubbie
