# What the container reads. Compose picks this file up as `docker/.env`; the repository's own
# `.env` is for a dev server and is deliberately not shared with it.

# The port on the host, and what it is bound to. Loopback by default, because a public host
# reaches this through the `tls` profile rather than through a published port.
HTTP_PORT=3000
HTTP_BIND=127.0.0.1

# The hostname Caddy gets a certificate for, with the `tls` profile. It has to resolve to this
# machine before the first start, or the certificate cannot be issued.
SITE_HOST=

# Set when something in front terminates TLS, which is exactly what the `tls` profile is. Without
# it the app sees plain HTTP and drops `Secure` from the session cookie of every real deployment.
TRUST_PROXY=

# The public origin members reach. OAuth redirects, calendar urls and every link the club sends
# are built from it, so it is the address behind your proxy, not localhost, in production.
BASE_URL=http://localhost:3000

# openssl rand -base64 32
SESSION_SECRET=

# The volume the image declares. Change it only to run Postgres instead:
# DATABASE_URL=postgres://clubbie:clubbie@postgres:5432/clubbie
DATABASE_URL=sqlite:/data/clubbie.db

# At least one sign-in provider. Others are inert while unset. The rest, and the private key an
# openid connect provider can use instead of a secret, are in the repository's own .env.example:
# eduid, github, google, microsoft, gitlab, discord, and oidc for anything else.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
EDUID_CLIENT_ID=
EDUID_CLIENT_SECRET=

# Optional: the Telegram bot that links accounts and carries announcements.
TELEGRAM_TOKEN=

# Optional: email, for members who never link a chat. Commented out rather than left empty: a
# transport with no sender is refused at boot, so a copy of this file with the block filled in
# halfway never starts. Uncomment the three that go together and the channel is on.
# EMAIL_FROM=clubbie@yourclub.example
# resend (default), postmark, sendgrid, mailgun, brevo, mailjet, smtp
# EMAIL_TRANSPORT=resend
# EMAIL_API_KEY=
# smtp only, instead of the key: smtp://user:pass@host:587
# EMAIL_SMTP_URL=

# The wall clock a repeating event keeps when the club has set no timezone. A container carries
# no zone at all, so an unset TZ here is UTC.
TZ=Europe/Zurich

LOG_LEVEL=info
# Set to write one JSON object per line, for a log collector.
LOG_JSON=

# Only when the postgres profile is running.
POSTGRES_USER=clubbie
POSTGRES_PASSWORD=clubbie
POSTGRES_DB=clubbie
